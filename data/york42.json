  "activity_log": [
    {
      "title": "Garden Design — Three-Zone Planting Proposal",
      "date": "2025",
      "type": "Design",
      "category": "planting",
      "notes": "Gardener & Son developed a three-zone planting proposal for this Mont Albert property. The Entrance Garden features columnar cherry blossom (Prunus cerasifera 'Oakville Crimson Spire') as a focal tree, underplanted with layered grasses, groundcovers and flowering shrubs including Poa labillardieri, Brachyscome, Lavender and Catmint. The Sensory Garden weaves together aromatic herbs — Rosemary, Curry Plant and Billy Buttons — with native groundcovers Dichondra and Kennedia. The Rear Garden is anchored by Weeping Lilly Pilly (Waterhousia floribunda) with shade-tolerant Aspidistra and Native Violet beneath. Together the three zones deliver five structural layers and 10 indigenous species across approximately 300m² of garden."
    },
    {
      "title": "Garden Installation Complete",
      "date": "2025",
      "type": "Installation",
      "category": "planting",
      "notes": "All three zones installed. Arborist mulch applied to 75mm depth across planted areas. Garden presented as part of the property's real estate marketing, demonstrating that ecological function and market appeal are not in conflict."
    }
  ],
